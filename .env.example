# OpenRouter (Chat Completions path — required)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pick a free/cheap OpenRouter model id, e.g. openai/gpt-4o-mini or a free tier model
OPENROUTER_MODEL=openai/gpt-4o-mini

# Temporal — defaults match the orchestration compose stack
TEMPORAL_ADDRESS=localhost:7234
TEMPORAL_NAMESPACE=default
TASK_QUEUE=agents

# Lab data
AGENTS_DATA_DIR=./data
